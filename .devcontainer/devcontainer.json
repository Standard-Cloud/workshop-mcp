{
  "name": "MCP Business Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "bash scripts/start.sh",
  "forwardPorts": [8001, 8002, 8003, 9001, 9002, 9003],
  "portsAttributes": {
    "8001": { "label": "Prix Malin API", "onAutoForward": "silent" },
    "8002": { "label": "HyperMax API", "onAutoForward": "silent" },
    "8003": { "label": "BricoPro API", "onAutoForward": "silent" },
    "9001": { "label": "Prix Malin MCP", "onAutoForward": "silent" },
    "9002": { "label": "HyperMax MCP", "onAutoForward": "silent" },
    "9003": { "label": "BricoPro MCP", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat"]
    }
  }
}
